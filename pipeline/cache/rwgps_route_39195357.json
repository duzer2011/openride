{"type": "route", "route": {"id": 39195357, "highlighted_photo_id": 12309469, "highlighted_photo_checksum": "a43237ebdf7ae7cfb6608effd1d8eaa4", "distance": 83.591, "elevation_gain": 1.49085, "elevation_loss": 0.0, "track_id": "6266c50a27a5148476af4d84", "user_id": 4462745, "pavement_type": null, "pavement_type_id": null, "recreation_type_ids": [3], "activity_types": ["cycling:generic"], "visibility": 0, "created_at": 1650902282, "updated_at": 1650914075, "name": "Natchez Trace to Mamie's Cottage B&B at the Dupree House - Raymond, Mississippi", "description": "Mamie's Cottage actually sits just off the Parkway at milepost 76.3). Cyclists can walk their bikes 150 yards off the Parkway to the cottage.\n\nIf you are biking south on the Parkway look for milepost 77. Keep biking south for .7 miles and the parkway will cross over an underpass (Dupree Road). On the south side of the underpass look to your left (east). You will see some ribbons on the trees. Walk your bikes along the ribbon path to the B&B!\n\nIf you are biking north on the Parkway look for milepost 76. Keep biking north for .3 miles. Just before the Parkway crosses over an underpass (Dupree Road) look to your right (east). You will see some ribbons on the trees. Walk your bikes along the ribbon path to the B&B!\n\nMore information about Mamie's Cottage B&B at the Dupree House: \nhttps://www.natcheztracetravel.com/raymond-bedandbreakfasts/mamies-cottage.html", "first_lng": -90.504531, "first_lat": 32.260752, "last_lat": 32.260018, "last_lng": -90.504343, "bounding_box": [{"lat": 32.260018, "lng": -90.504531}, {"lat": 32.260752, "lng": -90.504343}], "locality": "Hinds County", "postal_code": null, "administrative_area": "MS", "country_code": "US", "privacy_code": null, "user": {"id": 4462745, "created_at": "2022-01-19T07:12:15-08:00", "interests": null, "description": null, "locality": "Nashville", "administrative_area": "Tennessee", "account_level": 0, "total_trip_distance": 0, "total_trip_duration": 0, "tot