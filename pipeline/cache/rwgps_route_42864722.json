d": 4462745}, {"id": 56015377, "lng": -91.126541, "lat": 31.894384, "url": "https://natcheztracetravel.com/lorman-bedandbreakfasts/canemount/3647-bicycle-the-natchez-trace.html", "mongo_id": null, "parent_id": 7874, "parent_type": "Club", "created_at": "2022-02-21T11:13:54-08:00", "updated_at": "2023-11-30T13:26:43-08:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 10, "n": "Canemount Plantation Inn B&B", "d": "Canemount Plantation B&B is located in Claiborne County, MS - two miles north of Alcorn State University, three miles south of Windsor Ruins, fourteen miles south of Port Gibson, MS.", "pids": [12103488, 12103486, 12103487], "uid": 4462745}, {"id": 57911493, "lng": -91.12918853759767, "lat": 31.906089604916776, "url": "https://www.natcheztracetravel.com/natchez-trace-mississippi/loop-routes/windsor-ruins.html", "mongo_id": null, "parent_id": 7874, "parent_type": "Club", "created_at": "2022-03-30T12:15:18-07:00", "updated_at": "2022-03-30T12:15:18-07:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 14, "n": "Bethel Church", "d": "The original congregation of the Bethel Presbyterian Church organized in 1826 under the direction of Dr. Jeremiah Chamberlain. The building, that still stands today, was built in the mid 1840s. During Grant\u2019s campaign to take Vicksburg, he landed his troops east of the Mississippi River just a few miles from here at Bruinsburg. His troops passed Bethel Church on April 30th, 1863 moving to Port Gibson on the Rodney Road.", "pids": [12208777], "uid": 4462745}, {"id": 58551710, "lng": -90.97224712371826, "lat": 31.940654805051913, "url": null, "mongo_id": null, "parent_id": 7874, "parent_type": "Club", "created_at": "2022-04-11T06:53:23-07:00", "updated_at": "2023-03-21T08:43:26-07:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 37, "n": "Recommended  Bicycle Route from Parkway to Port Gibson", "d": "On the north side of the \nbridge (milepost 39.2) walk your bikes off \nthe west side of the parkway into\nthe Port Gibson District Office  \ndriveway. Then walk your bikes\naround the south side of the \nbuilding back to the maintenance\ndriveway. The driveway connects\nto McComb Ave / Hwy 547.", "pids": [12250629], "uid": 4462745}, {"id": 82486441, "lng": -90.978012, "lat": 31.973539, "url": null, "mongo_id": null, "parent_id": 42864722, "parent_type": "Route", "created_at": "2023-05-12T08:03:20-07:00", "updated_at": "2023-05-12T08:03:20-07:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 13, "n": "Sonic Drive-In", "d": "On US 61 north of Port Gibson.", "pids": [], "uid": 4462745}, {"id": 82486442, "lng": -90.978355, "lat": 31.972029, "url": null, "mongo_id": null, "parent_id": 42864722, "parent_type": "Route", "created_at": "2023-05-12T08:03:20-07:00", "updated_at": "2023-05-12T08:03:20-07:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 13, "n": "Pizza Hut", "d": "On US 61 north of Port Gibson.", "pids": [], "uid": 4462745}, {"id": 82486443, "lng": -90.979485, "lat": 31.96855, "url": null, "mongo_id": null, "parent_id": 42864722, "parent_type": "Route", "created_at": "2023-05-12T08:03:20-07:00", "updated_at": "2023-05-12T08:03:20-07:00", "community_poi_id": null, "locality": null, "administrative_area": null, "country_code": null, "location_hex": null, "v": 0, "t": 13, "n": "Best Wok", "d": "Open 7 days for lunch and dinner. 1091 U.S. 61, Port Gibson, MS", "pids": [], "uid": 4462745}, {"id": 82486444, "lng": -90.988838, "lat": 31.96398, "url": null, "mongo_id": null, "parent_id": 42864722, "parent_type": "Route", "created_at": "2023-05-12T08:03:20-07:00", "updated_at": 